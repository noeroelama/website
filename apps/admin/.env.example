# apps/admin — copy to .env.local for development. NEVER commit real values.
APP_ENV=development
LOG_LEVEL=info

# Firebase Admin, Authentication only (admin service account: verify sessions, manage accounts)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# MySQL on cPanel (all data; Firebase is only sign-in). Each app its own MySQL user (cPanel → MySQL Databases).
# mysql://<cpaneluser_app>:<password>@localhost:3306/<cpaneluser_ppidk>; locally a staging copy or Remote MySQL.
DATABASE_URL=
DATABASE_CONNECTION_LIMIT=5

# Uploaded files on the cPanel disk: an absolute folder outside every app folder, the SAME on web and admin,
# e.g. /home/<cpaneluser>/ppidk-files. Public files are served by web at /files/…, private ones by signed links.
FILE_STORAGE_DIR=

# Firebase web config (public by design; used by the sign-in page)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Staff session lifetime in hours (1-12)
SESSION_MAX_AGE_HOURS=8
# ONE session shared by web, admin and shop: the parent domain, e.g. ppiasiania.id (empty = host-only, local dev)
SESSION_COOKIE_DOMAIN=

# Sign-in happens on the web app, which sends the user back here. Without both, signed-out
# visitors see "sign-in required" instead of being redirected. Local: http://localhost:3000 and :3001
WEB_URL=
ADMIN_URL=

# Outgoing messages: empty or log = record only (default, every environment shares the live data);
# live = send in production; elsewhere only to MESSAGING_TEST_RECIPIENTS (comma-separated e-mails
# and/or E.164 WhatsApp numbers such as +6281234567890)
MESSAGING_MODE=
MESSAGING_TEST_RECIPIENTS=

# WAHA (WhatsApp HTTP API) for proactive WhatsApp messages; empty = WhatsApp not configured
# (messages to people with a WhatsApp number then fail and wait on the Email page for a retry)
WAHA_BASE_URL=
WAHA_API_KEY=
WAHA_SESSION=
WAHA_WEBHOOK_SECRET=

# Short links: goppi.id (primary; base URL of its API and key) and s.id (fallback, API v2 key);
# a provider without its key is skipped, automatic links then keep the long URL
GOPPI_BASE_URL=
GOPPI_API_KEY=
SHORTLINK_API_KEY=

# Anthropic for machine-drafted minutes (F6); empty = the Draft button is off
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Resend (transactional email + newsletter broadcasts)
RESEND_API_KEY=
EMAIL_FROM_TRANSACTIONAL=
EMAIL_FROM_NEWSLETTER=
RESEND_WEBHOOK_SECRET=

# Newsletter: the SAME values as in apps/web (>= 32 chars each). LINK_SIGNING_SECRET signs the
# unsubscribe, open and click links; SUBSCRIBER_HASH_SECRET gives staff-added subscribers the
# same id as a web sign-up (never rotate it). Certificate pickup (D5-P) uses both too: pasted
# participant e-mails are stored as keyed hashes; the website signs the sheet download links.
LINK_SIGNING_SECRET=
SUBSCRIBER_HASH_SECRET=

# Zoom Server-to-Server OAuth (meeting requests)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_USER=
ZOOM_WEBHOOK_SECRET_TOKEN=

# Google Drive for the Zoom recording archive: service account (domain-wide delegation, Drive
# scope), the Workspace user it acts as, and the archive folder id; empty = archive off
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_IMPERSONATE=
GOOGLE_DRIVE_FOLDER_ID=

# Signed ICS calendar feed
CALENDAR_FEED_SIGNING_SECRET=

# cPanel Cron Jobs call GET /cron/<job> with "Authorization: Bearer <this>" (>= 32 chars).
# Also stored in ~/.config/ppidk/cron-secret on the server (chmod 600). Empty = every cron call is 401.
CRON_SECRET=

# Per-IP rate limiting (HMAC key, >= 32 chars). Required in staging/production; different per environment.
RATE_LIMIT_SECRET=

# Letters: host that answers printed verification codes (e.g. verif.ppiasiania.id, added to the web
# app). Empty = the QR points to WEB_URL/verify/<code>.
VERIFICATION_HOST=

# Personal signatures (/account/signature): AES-256-GCM key, 32 random bytes base64 (44 chars).
# The SAME value on web and admin (this app decrypts them for letters). Never change it: stored signatures become
# unreadable. Empty = signatures are off.
FIELD_ENCRYPTION_KEY=
